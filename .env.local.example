# Supabase — gebruik de NIEUWE API key naming (sb_publishable_*), niet de legacy anon key.
# Te vinden in: Supabase dashboard → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enkel nodig voor het seed-script (pnpm seed), NIET voor de app zelf.
# Dit is de secret / service_role key — houd 'm geheim, commit 'm nooit.
SUPABASE_SECRET_KEY=

# Optioneel: gratis Giphy API-key (developers.giphy.com) voor de GIF-knop in de
# chat. Zonder key verschijnt de GIF-knop niet. Dit is een publieke client-key.
NEXT_PUBLIC_GIPHY_API_KEY=
